<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Hadir QA Automation Suite">
    <!-- 1. Smoke Tests (Java TestNG murni yang sudah terbukti PASS) -->
    <test name="Smoke Tests">
        <classes>
            <class name="com.hadir.tests.LoginTest"/>
        </classes>
    </test>

    <!-- 2. Cucumber BDD Test Suite -->
    <test name="Cucumber BDD Tests">
        <classes>
            <class name="com.hadir.runners.TestRunner"/>
        </classes>
    </test>
</suite>
